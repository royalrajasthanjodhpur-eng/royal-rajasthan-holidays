# ─────────────────────────────────────────────────────────────
# ROYAL RAJASTHAN HOLIDAYS — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# Only NEXT_PUBLIC_* variables are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Public site
NEXT_PUBLIC_SITE_URL=https://www.royalrajasthanholidays.com
NEXT_PUBLIC_WHATSAPP_NUMBER=919414196978

# ── Database (Neon Postgres, pooled connection string) ──
# Marketing pages MUST build without this set. Only API routes / server
# actions require it (lazy init — see src/server/db/client.ts).
DATABASE_URL=

# ── Auth.js (NextAuth v5) ──
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Seed credentials for the first admin user (used by `npm run db:seed`).
# Change the password immediately after the first login.
ADMIN_EMAIL=royalrajasthanjodhpur@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=Prakash Arora

# ── Image storage (Cloudinary preferred) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Supabase Storage — acceptable equivalent if Cloudinary is unavailable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# ── Email notifications (SMTP) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Royal Rajasthan Holidays <royalrajasthanjodhpur@gmail.com>"
EMAIL_TO=royalrajasthanjodhpur@gmail.com

# ── Analytics ──
GOOGLE_ANALYTICS_ID=

# ── Social profiles (used for JSON-LD sameAs) ──
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/royal_rajasthan_holidays
# Exact Facebook page URL not yet confirmed by the business owner — leave blank
# rather than guessing a slug.
NEXT_PUBLIC_FACEBOOK_URL=
